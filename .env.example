# ==============================================================================
# Django Configuration
# ==============================================================================
SECRET_KEY=django-insecure-replace-with-a-random-secret-key-64-characters
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://localhost:8000

# ==============================================================================
# Database Configuration (Supabase PostgreSQL / Local)
# For Supabase (Transaction Pooler - Port 6543):
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# ==============================================================================
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# ==============================================================================
# Currency & Exchange Rate (Cambodia)
# ==============================================================================
EXCHANGE_RATE_USD_TO_KHR=4100
DEFAULT_CURRENCY=USD

# ==============================================================================
# Shop Information
# ==============================================================================
SHOP_NAME=Smart Clean Laundry
SHOP_NAME_KH=ហាងបោកអ៊ុត ស្មាតឃ្លីន
SHOP_PHONE=012 345 678 / 098 765 432
SHOP_ADDRESS_KH=រាជធានីភ្នំពេញ, ប្រទេសកម្ពុជា

# ==============================================================================
# Telegram Bot Alerts (Optional - Outbound to Owner & Customer)
# ==============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
